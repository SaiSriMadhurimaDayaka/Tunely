# iTunes Search API discovery requires no credentials.
ITUNES_CACHE_TTL_SECONDS=21600
ITUNES_SEARCH_COUNTRY=in
ITUNES_SEARCH_TIMEOUT_SECONDS=8
TUNELY_LYRICS_TIMEOUT_SECONDS=4
# Optional path to an already fine-tuned, local XLM-RoBERTa emotion checkpoint.
# Tunely does not download model weights; without this, a conservative
# multilingual lyric lexicon is used and uncertain tracks remain Unknown.
TUNELY_XLMR_EMOTION_MODEL=
TUNELY_PORT=5002

# Set a stable random value for persistent local sessions.
TUNELY_SECRET_KEY=
TUNELY_COOKIE_SECURE=false
